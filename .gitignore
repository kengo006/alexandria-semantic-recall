# derived data — your corpus's chunks and vectors live here; never commit them
index/
index_prev/
lance_db/

# model weights (downloaded on first run)
model_cache/

# environments / caches
.venv/
__pycache__/
*.pyc

# `uv run` writes a lock file on first use. This repository does not ship one yet
# (whether it should is still open: CHANGELOG v0.5.1), so a run leaves the clone clean.
uv.lock
